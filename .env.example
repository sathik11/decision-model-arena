# Decision engine for the single-engine endpoint: auto, jev, laya, or rules
DECISION_ENGINE=auto
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Open-weight typed-decision alternative
LAYA_ENDPOINT=
LAYA_MODEL=convaiinnovations/laya-typed-decisions
LAYA_SUBFOLDER=
LAYA_DEVICE=cuda

# Microsoft Foundry generative baseline and hosted-agent configuration
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Optional price assumptions used only for the UI estimate.
FOUNDRY_INPUT_USD_PER_1M=0
FOUNDRY_OUTPUT_USD_PER_1M=0

# CPU deployment only. Oversubscribing threads is measurably slower on hybrid
# P/E-core CPUs: 20 threads measured 2.5x slower than 8 on this model.
# Defaults to min(8, cpu_count) when LAYA_DEVICE=cpu.
# LAYA_CPU_THREADS=8
